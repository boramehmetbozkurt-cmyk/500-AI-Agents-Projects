APP_ENV=development
OSIRIS_BASE_URL=https://osirisai.live
OSIRIS_FUSION_API_KEY=

# Local-first model router
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:4b
LLM_THINK=false
AI_PLANNER_ENABLED=true

# Optional trusted OpenAI-compatible fallback
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# Runtime budgets
TOOL_TIMEOUT_SECONDS=20
LLM_TIMEOUT_SECONDS=120
MAX_PARALLEL_TOOLS=5
MAX_EVIDENCE_BYTES=1500000
MAX_PROMPT_EVIDENCE_CHARS=60000
MAX_TOOL_CALLS=8
REQUEST_LIMIT_PER_MINUTE=30

# Persistence / watchlists
FUSION_STORE_PATH=fusion.sqlite3
WATCHER_ENABLED=false
WATCHER_POLL_SECONDS=300

# Source licensing policy
COMMERCIAL_MODE=false
STRICT_COMMERCIAL_SOURCES=true
LICENSED_PROVIDERS=

# Browser UI / CORS
UI_ENABLED=true
CORS_ORIGINS=

# SEAL authorization + tamper-evident receipts
SEAL_TTL_SECONDS=300
SEAL_REPLAY_DB=.seal_replay.sqlite3
SEAL_ED25519_PRIVATE_KEY_B64=
REQUIRE_SIGNED_RECEIPTS=false
