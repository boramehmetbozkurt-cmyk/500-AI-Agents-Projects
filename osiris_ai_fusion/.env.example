APP_ENV=development
# ORBYTHRA primary configuration. If unset, legacy OSIRIS_* variables remain accepted.
ORBYTHRA_BASE_URL=
# Optional bootstrap/admin key. Public SaaS users receive tenant-scoped keys instead.
ORBYTHRA_FUSION_API_KEY=

# Legacy compatibility only; avoid in new deployments.
OSIRIS_BASE_URL=
OSIRIS_FUSION_API_KEY=

# Public SaaS
SAAS_ENABLED=true
SAAS_PUBLIC_SIGNUP_ENABLED=true
SAAS_SESSION_TTL_SECONDS=604800
# Required for hosted Stripe checkout redirect URLs, e.g. https://orbythra.example.com
SAAS_BASE_URL=

# Stripe subscriptions (optional until billing is enabled; configure all four together)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# Local-first model router
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:4b
LLM_THINK=false
AI_PLANNER_ENABLED=true

# Optional trusted OpenAI-compatible fallback
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# Multi-provider federation
# The router can fan one query out to multiple ranked read-only providers.
# Built-in live providers that do not require secrets include Wikipedia TR,
# OpenAlex, Crossref, OpenStreetMap Nominatim and Hacker News Algolia.
FUSION_PROVIDER_FANOUT=3
FUSION_PROVIDER_DIR=
FUSION_CAPABILITY_DIR=

# Configured provider gateway contract:
# POST JSON {"query":"...","scope":{...},"mode":"read_only"}
# General web is a FALLBACK provider, not the central or only provider.
FUSION_WEB_SEARCH_URL=
FUSION_WEB_SEARCH_API_KEY=

# Domain providers. Configure any subset; the router discovers ready providers.
FUSION_SPORTS_URL=
FUSION_SPORTS_API_KEY=
FUSION_FINANCE_URL=
FUSION_FINANCE_API_KEY=
FUSION_CRYPTO_URL=
FUSION_CRYPTO_API_KEY=
FUSION_NEWS_URL=
FUSION_NEWS_API_KEY=
FUSION_SCIENCE_URL=
FUSION_SCIENCE_API_KEY=
FUSION_PATENTS_URL=
FUSION_PATENTS_API_KEY=
FUSION_COMPANIES_URL=
FUSION_COMPANIES_API_KEY=
FUSION_LEGAL_URL=
FUSION_LEGAL_API_KEY=
FUSION_REAL_ESTATE_URL=
FUSION_REAL_ESTATE_API_KEY=
FUSION_VEHICLES_URL=
FUSION_VEHICLES_API_KEY=
FUSION_JOBS_URL=
FUSION_JOBS_API_KEY=
FUSION_TRAVEL_URL=
FUSION_TRAVEL_API_KEY=
FUSION_SHOPPING_URL=
FUSION_SHOPPING_API_KEY=
FUSION_SOCIAL_URL=
FUSION_SOCIAL_API_KEY=
FUSION_PLACES_URL=
FUSION_PLACES_API_KEY=

# Runtime budgets
TOOL_TIMEOUT_SECONDS=20
LLM_TIMEOUT_SECONDS=120
MAX_PARALLEL_TOOLS=5
MAX_EVIDENCE_BYTES=1500000
MAX_PROMPT_EVIDENCE_CHARS=60000
MAX_TOOL_CALLS=8
REQUEST_LIMIT_PER_MINUTE=30

# Persistence / watchlists
# For a public single-instance deployment, mount this DB on persistent storage.
FUSION_STORE_PATH=fusion.sqlite3
WATCHER_ENABLED=false
WATCHER_POLL_SECONDS=300

# Source licensing policy
COMMERCIAL_MODE=false
STRICT_COMMERCIAL_SOURCES=true
LICENSED_PROVIDERS=

# Browser UI / CORS
UI_ENABLED=true
CORS_ORIGINS=

# SEAL authorization + tamper-evident receipts
SEAL_TTL_SECONDS=300
SEAL_REPLAY_DB=.seal_replay.sqlite3
SEAL_ED25519_PRIVATE_KEY_B64=
REQUIRE_SIGNED_RECEIPTS=false
