{
  "name": "orbythra-adaptive-generalist-challenge-v1",
  "version": 1,
  "minimum_exact_match_rate": 1.0,
  "boundary": "Internal deterministic regression corpus for evidence-gated learning and constrained meta-routing. It is not AGI, continual model-weight learning, or independent cross-domain generalization evidence.",
  "scenarios": [
    {"id":"learn-accept-clear","kind":"learning","input":{"baseline_score":0.50,"candidate_score":0.70,"minimum_improvement":0.05},"expected":{"decision":"ACCEPT","improvement":0.20}},
    {"id":"learn-accept-threshold","kind":"learning","input":{"baseline_score":0.60,"candidate_score":0.65,"minimum_improvement":0.05},"expected":{"decision":"ACCEPT","improvement":0.05}},
    {"id":"learn-reject-below","kind":"learning","input":{"baseline_score":0.60,"candidate_score":0.64,"minimum_improvement":0.05},"expected":{"decision":"REJECT","improvement":0.04}},
    {"id":"learn-reject-regression","kind":"learning","input":{"baseline_score":0.80,"candidate_score":0.70,"minimum_improvement":0.01},"expected":{"decision":"REJECT","improvement":-0.10}},
    {"id":"learn-zero-threshold","kind":"learning","input":{"baseline_score":0.80,"candidate_score":0.80,"minimum_improvement":0.0},"expected":{"decision":"ACCEPT","improvement":0.0}},
    {"id":"route-best-utility","kind":"route","input":{"domain":"engineering","required_capabilities":["reason"],"max_risk_tier":"high","strategies":[{"strategy_id":"a","domains":["engineering"],"capabilities":["reason"],"risk_tier":"moderate","success_score":0.7,"latency_score":0.3,"cost_score":0.3,"enabled":true},{"strategy_id":"b","domains":["engineering"],"capabilities":["reason"],"risk_tier":"moderate","success_score":0.9,"latency_score":0.2,"cost_score":0.2,"enabled":true}]},"expected":{"strategy_id":"b","utility_score":0.87}},
    {"id":"route-risk-filter","kind":"route","input":{"domain":"engineering","required_capabilities":["reason"],"max_risk_tier":"high","strategies":[{"strategy_id":"critical","domains":["engineering"],"capabilities":["reason"],"risk_tier":"critical","success_score":1.0,"latency_score":0.0,"cost_score":0.0,"enabled":true},{"strategy_id":"safe","domains":["engineering"],"capabilities":["reason"],"risk_tier":"moderate","success_score":0.7,"latency_score":0.5,"cost_score":0.5,"enabled":true}]},"expected":{"strategy_id":"safe","utility_score":0.64}},
    {"id":"route-domain-filter","kind":"route","input":{"domain":"finance","required_capabilities":["reason"],"max_risk_tier":"high","strategies":[{"strategy_id":"eng","domains":["engineering"],"capabilities":["reason"],"risk_tier":"low","success_score":1.0,"latency_score":0.0,"cost_score":0.0,"enabled":true}]},"expected":{"strategy_id":null,"utility_score":null}},
    {"id":"route-capability-filter","kind":"route","input":{"domain":"engineering","required_capabilities":["reason","verify"],"max_risk_tier":"high","strategies":[{"strategy_id":"partial","domains":["engineering"],"capabilities":["reason"],"risk_tier":"low","success_score":1.0,"latency_score":0.0,"cost_score":0.0,"enabled":true}]},"expected":{"strategy_id":null,"utility_score":null}},
    {"id":"route-disabled-filter","kind":"route","input":{"domain":"engineering","required_capabilities":["reason"],"max_risk_tier":"high","strategies":[{"strategy_id":"off","domains":["engineering"],"capabilities":["reason"],"risk_tier":"low","success_score":1.0,"latency_score":0.0,"cost_score":0.0,"enabled":false}]},"expected":{"strategy_id":null,"utility_score":null}},
    {"id":"route-tie-stable","kind":"route","input":{"domain":"engineering","required_capabilities":["reason"],"max_risk_tier":"high","strategies":[{"strategy_id":"z","domains":["engineering"],"capabilities":["reason"],"risk_tier":"low","success_score":0.8,"latency_score":0.2,"cost_score":0.2,"enabled":true},{"strategy_id":"a","domains":["engineering"],"capabilities":["reason"],"risk_tier":"low","success_score":0.8,"latency_score":0.2,"cost_score":0.2,"enabled":true}]},"expected":{"strategy_id":"a","utility_score":0.8}},
    {"id":"route-wildcard-domain","kind":"route","input":{"domain":"new-domain","required_capabilities":["reason"],"max_risk_tier":"moderate","strategies":[{"strategy_id":"general","domains":[],"capabilities":["reason"],"risk_tier":"moderate","success_score":0.75,"latency_score":0.4,"cost_score":0.4,"enabled":true}]},"expected":{"strategy_id":"general","utility_score":0.705}}
  ]
}
