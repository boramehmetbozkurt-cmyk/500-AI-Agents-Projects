ORBYTHRA_ENV=production
ORBYTHRA_DATABASE_URL=postgresql+psycopg://orbythra:change-me@postgres:5432/orbythra
ORBYTHRA_DB_PATH=/data/orbythra.db
ORBYTHRA_API_KEYS=operator:replace-with-a-long-random-secret
ORBYTHRA_API_ROLES=operator=admin
# For enterprise SSO, API keys may be left empty when OIDC is configured.
ORBYTHRA_OIDC_ISSUER=
ORBYTHRA_OIDC_AUDIENCE=
ORBYTHRA_OIDC_JWKS_URL=
ORBYTHRA_OIDC_JWKS_JSON=
ORBYTHRA_OIDC_WORKSPACE_CLAIM=orbythra_workspace
ORBYTHRA_OIDC_ROLE_CLAIM=orbythra_role
# V22 cryptographic roots. Encryption and signing roots MUST be different in production.
ORBYTHRA_MASTER_KEYS=enc-v22:replace-with-32-byte-base64url-key
ORBYTHRA_SIGNING_KEYS=sig-v22:replace-with-a-different-32-byte-base64url-key
ORBYTHRA_CRYPTO_ALGORITHM=aes256-gcm
# off | hybrid-preferred | hybrid-required. Production default is hybrid-required.
ORBYTHRA_PQC_MODE=hybrid-required
# Ignored/forced false in production; only development/test may opt into opaque legacy approvals.
ORBYTHRA_ALLOW_LEGACY_APPROVALS=false
ORBYTHRA_KEY_MANAGEMENT_MODE=environment
ORBYTHRA_RATE_LIMIT_PER_MINUTE=120
ORBYTHRA_MAX_BODY_BYTES=2000000
ORBYTHRA_RELEASE_SHA=replace-with-deployed-release-sha
ORBYTHRA_DEFAULT_MODEL_ID=default
ORBYTHRA_EVIDENCE_PROVIDER_URL=
ORBYTHRA_EVIDENCE_PROVIDER_TOKEN=
ORBYTHRA_LLM_PROVIDER_URL=
ORBYTHRA_LLM_PROVIDER_TOKEN=
# Optional V21 OTLP/HTTP trace export. Leave endpoint empty to keep export disabled.
ORBYTHRA_OTLP_ENDPOINT=
ORBYTHRA_OTLP_SERVICE_NAME=orbythra
ORBYTHRA_OTLP_HEADERS=
# Optional V20 adapter-training service. The API process never trains arbitrary foundation weights itself.
ORBYTHRA_TRAINING_PROVIDER_URL=
ORBYTHRA_TRAINING_PROVIDER_TOKEN=
# Optional isolated service used to evaluate invented declarative skills.
ORBYTHRA_SKILL_SANDBOX_URL=
ORBYTHRA_SKILL_SANDBOX_TOKEN=
# Comma-separated adapter ids or id@version values accepted for multimodal semantic fusion.
ORBYTHRA_MULTIMODAL_ALLOWED_ADAPTERS=
SERPAPI_API_KEY=
SERPAPI_KEY=
SERPAPI_HL=
SERPAPI_GL=
SERPAPI_LOCATION=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
POSTGRES_PASSWORD=replace-with-a-long-random-secret
# V23.1 keyless web search (DuckDuckGo HTML, Bing HTML fallback). No API key needed. Set false to disable.
ORBYTHRA_KEYLESS_SEARCH=true
ORBYTHRA_KEYLESS_SEARCH_REGION=wt-wt
# V23.1 file attachments (in-memory, workspace-scoped, TTL in seconds)
ORBYTHRA_ATTACHMENT_MAX_BYTES=8388608
ORBYTHRA_ATTACHMENT_MAX_FILES=20
ORBYTHRA_ATTACHMENT_TTL_SECONDS=21600
